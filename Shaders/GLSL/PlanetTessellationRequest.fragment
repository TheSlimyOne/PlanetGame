#[fragment] 
#version 450 

layout(early_fragment_tests) in;

layout(location = 0) flat in uvec4 key;
layout(location = 1) flat in uint flags;
layout(location = 2) in float morph;
layout(location = 3) in float elevation;
layout(location = 4) in vec2 vertex_uv;
layout(location = 5) flat in int lod;
layout(location = 6) in vec3 normal;
layout(location = 7) in vec3 world_position;
layout(location = 8) flat in uint instance_id;

layout(location = 0) out vec4 frag_color; 
layout(location = 1) out vec4 picking_texture;

layout(set = 0, binding = 1, std430) buffer restrict readonly ExternalData {
	int low_resolution_mip_count;
	int high_resolution_mip_count;
    int tile_size;
	int lod_to_mip_map[32];

	float radius;
	int resolution;
	float height_scale;
	float sub_factor;
	uint debug_flags;

	int maximum_lod;
	int minimum_lod;

	vec2 morph_range;

	mat4 planet_transform_matrix;
	mat4 view_projection_matrix;
	vec4 camera_position_fovy;
};

layout(set = 0, binding = 2) uniform sampler2DArray height_map_tile_cache;
layout(set = 0, binding = 3) uniform sampler2DArray terrain_indirection_table;
layout(set = 0, binding = 4, r32ui) uniform uimage2DArray state_table;


#[include] res://Shaders/GLSL/ShaderIncludes/TesselationFunctions.inc

#[include] res://Shaders/GLSL/ShaderIncludes/Functions.inc

mat4 remove_scale(mat4 transform)
{
    transform[0].xyz = normalize(transform[0].xyz);
    transform[1].xyz = normalize(transform[1].xyz);
    transform[2].xyz = normalize(transform[2].xyz);

    return transform;
}

vec3 hash(uvec3 value)
{
    uint hashed =
        value.x * 0x9E3779B9u ^
        value.y * 0x85EBCA6Bu ^
        value.z * 0xC2B2AE35u;

    hashed ^= hashed >> 16u;
    hashed *= 0x7FEB352Du;
    hashed ^= hashed >> 15u;
    hashed *= 0x846CA68Bu;
    hashed ^= hashed >> 16u;

    return vec3(
        hashed & 255u,
        (hashed >> 8u) & 255u,
        (hashed >> 16u) & 255u
    ) / 255.0;
}

void main() {
    
    vec2 adjusted_uv = clamp(vertex_uv, vec2(0.0), vec2(1.0 - EPS));

    int non_negative_mip_index = lod_to_mip_map[lod] + high_resolution_mip_count;
    int normal_id = int(key.z);
    int total_resolution_mip_count = low_resolution_mip_count + high_resolution_mip_count;

	float grid_size = exp2(float(total_resolution_mip_count - 1));
	float lod_grid_size = grid_size / exp2(float(non_negative_mip_index));

    vec2 lod_grid_position = adjusted_uv * lod_grid_size;

    vec2 grid_uv = fract(lod_grid_position);

    vec2 grid_position = floor(lod_grid_position) / lod_grid_size;
    int layer = total_resolution_mip_count * normal_id + non_negative_mip_index;

    ivec3 indirection_index = ivec3(
        grid_position * grid_size, 
        layer
    );

    
    const uint PROCESSING = 0xFFFFFFFF;
    const uint NOT_PROCESSING = 0x00000000;
    uint results = imageAtomicCompSwap(
        state_table, 
        indirection_index, 
        NOT_PROCESSING, 
        PROCESSING
    );

