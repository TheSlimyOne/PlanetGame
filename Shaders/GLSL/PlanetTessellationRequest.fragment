#[fragment]
#version 450
#extension GL_EXT_shader_image_load_formatted : enable

layout(location = 0) flat in uvec4 key;
layout(location = 4) in vec2 plane_vertex_uv;
layout(location = 5) flat in int lod;
layout(location = 7) in vec3 world_position;

layout(location = 0) out vec4 feedback_texture;

layout(set = 0, binding = 1, std430) readonly buffer VirtualTextureData {
    uint low_resolution_mip_count;
    uint high_resolution_mip_count;
    uint grid_size;
    uint total_fallback_tiles;

    uint lod_to_mip_map[32];
};

layout(set = 0, binding = 4, std430) readonly buffer WorldData {
    float radius;
    float height_scale;
    vec2 padding;
    mat4 planet_transform_matrix;
};

layout(set = 0, binding = 6) uniform sampler2DArray heightmap_tile_cache;

layout(set = 0, binding = 7) restrict uniform image2DArray ConsolidatedIndirectionTable;

#[include] res://Shaders/GLSL/ShaderIncludes/Constants.inc
#[include] res://Shaders/GLSL/ShaderIncludes/TessellationFunctions.inc
#[include] res://Shaders/GLSL/ShaderIncludes/Functions.inc

void main() {
    vec2 adjusted_uv = clamp(plane_vertex_uv, vec2(0.0), vec2(1.0 - EPS));

    int mip_index = int(lod_to_mip_map[lod]);
    uint normal_id = key.z;

    int total_resolution_mip_count = int(low_resolution_mip_count + high_resolution_mip_count);

    int full_grid_size = 1 << (total_resolution_mip_count - 1);
    int mip_grid_size = 1 << mip_index;

    vec2 tile_coordinate = floor(adjusted_uv * mip_grid_size);
    vec2 grid_uv = tile_coordinate / mip_grid_size;

    int layer = total_resolution_mip_count * int(normal_id) + mip_index;

    ivec3 indirection_index = ivec3(
        grid_uv * full_grid_size,
        layer
    );

    vec3 tile_uv = get_tile_uv(ConsolidatedIndirectionTable, plane_vertex_uv,normal_id, low_resolution_mip_count, high_resolution_mip_count);

    vec3 color = get_tile(heightmap_tile_cache, tile_uv).xyz;

    feedback_texture = intBitsToFloat(ivec4(indirection_index, 1));
}