#[vertex]
#version 450

layout(std430, binding = 0) readonly buffer AtmosphereData {
    float radius;
    float density_falloff;
    uint light_sampling_count;
    uint optical_depth_sampling_count;
} atmosphere_data;

layout(std430, binding = 1) readonly buffer WorldData {
    float radius;
    float height_scale;
    vec2 padding;
    mat4 planet_transform_matrix;
} world_data;

layout(push_constant, std430) uniform PushConstants {
    mat4 view_projection_matrix;
    vec4 camera_position_fovy;
    vec4 sun_direction;
} push_constants;

layout(location = 0) in vec3 vertex_pos;
layout(location = 1) in vec3 vertex_normal;

layout(location = 0) out vec3 world_position;
layout(location = 1) out vec3 normal;

#[include] res://Shaders/GLSL/ShaderIncludes/Constants.inc
#[include] res://Shaders/GLSL/ShaderIncludes/TessellationFunctions.inc
#[include] res://Shaders/GLSL/ShaderIncludes/Functions.inc

void main()
{
    normal = (vec4(vertex_normal, 1) * get_rotation_from_matrix(world_data.planet_transform_matrix)).xyz; 
    // world_position = get_world_space_point(vertex_pos, world_data.planet_transform_matrix);// * atmosphere_data.radius;
    world_position = (vec4(vertex_pos * atmosphere_data.radius, 1) * get_translation_rotation_from_matrix(world_data.planet_transform_matrix)).xyz;
    
    gl_Position = push_constants.view_projection_matrix * vec4(world_position, 1.0);
}