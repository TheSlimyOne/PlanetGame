#[vertex]
#version 450

layout(location = 0) in vec3 vertex_pos;

layout(location = 0) out vec3 view_vector;

layout(push_constant, std430) uniform PushConstants {
    mat4 view_projection_matrix;
    vec4 camera_position_fovy;
} push_constants;


void main()
{
    gl_Position = vec4(vertex_pos.xy * 2.0, 0, 1);

    mat4 inverse_view_projection = inverse(push_constants.view_projection_matrix);

    vec4 world_position = inverse_view_projection * vec4(gl_Position.xy, 0, 1);

    world_position /= world_position.w;

    view_vector = world_position.xyz - push_constants.camera_position_fovy.xyz;
}