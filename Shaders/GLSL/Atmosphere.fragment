#[fragment]
#version 450

layout(set = 0, binding = 0, std430) readonly buffer AtmosphereData {
    float radius;
    float density_falloff;
    uint light_sampling_count;
    uint optical_depth_sampling_count;
} atmosphere_data;

layout(set = 0, binding = 1, std430) readonly buffer WorldData {
    float radius;
    float height_scale;
    vec2 padding;
    mat4 planet_transform_matrix;
} world_data;

layout(push_constant, std430) uniform PushConstants {
    mat4 view_projection_matrix;
    vec4 camera_position_fovy;
    vec4 sun_direction;
} push_constants;

layout(location = 0) in vec3 world_position;
layout(location = 1) in vec3 normal;

layout(location = 0) out vec4 frag_color;

float density_at_point(vec3 density_sample_point, vec3 planet_position) {
    float height_above_surface = length(density_sample_point - planet_position) - world_data.radius;
    float height01 = height_above_surface / (atmosphere_data.radius - world_data.radius);

    return exp(-height01 * atmosphere_data.density_falloff) * (1.0 - height01);
}

float optical_depth(vec3 ray_origin, vec3 ray_direction, float ray_length, vec3 planet_position) {
    vec3 density_sample_point = ray_origin;
    float step_size = ray_length / float(atmosphere_data.optical_depth_sampling_count - 1);
    float optical_depth_value = 0.0;

    for (uint i = 0u; i < atmosphere_data.optical_depth_sampling_count; i++) {
        optical_depth_value += density_at_point(density_sample_point, planet_position) * step_size;
        density_sample_point += ray_direction * step_size;
    }

    return optical_depth_value;
}

float calculate_light(vec3 ray_origin, vec3 ray_direction, float ray_length, vec3 planet_position) {
    vec3 in_scatter_point = ray_origin;
    float step_size = ray_length / float(atmosphere_data.light_sampling_count - 1);
    float in_scattered_light = 0.0;

    vec3 sun_direction = normalize(push_constants.sun_direction.xyz);

    for (uint i = 0u; i < atmosphere_data.light_sampling_count; i++) {
        float sun_ray_length = max(0.0, atmosphere_data.radius - length(in_scatter_point - planet_position));
        float sun_ray_optical_depth = optical_depth(in_scatter_point, sun_direction, sun_ray_length, planet_position);
        float view_ray_optical_depth = optical_depth(in_scatter_point, -ray_direction, step_size * float(i), planet_position);

        float transmittance = exp(-(sun_ray_optical_depth + view_ray_optical_depth));
        float local_density = density_at_point(in_scatter_point, planet_position);

        in_scattered_light += local_density * transmittance * step_size;
        in_scatter_point += ray_direction * step_size;
    }

    return in_scattered_light;
}

void main() {
    vec3 planet_position = (vec4(0.0, 0.0, 0.0, 1.0) * world_data.planet_transform_matrix).xyz;
    vec3 camera_position = push_constants.camera_position_fovy.xyz;

    vec3 ray_direction = normalize(world_position - camera_position);
    float ray_length = length(world_position - camera_position);

    float light = calculate_light(camera_position, ray_direction, ray_length, planet_position);

    // frag_color = vec4(vec3(light), light);
    frag_color = vec4(1, 1, 1, 0.75);
}