#[compute]
#version 450
#extension GL_EXT_shader_atomic_float2 : require
#extension GL_EXT_shader_image_load_formatted : enable

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 0, binding = 0) restrict uniform image2DArray IndirectionTable;

layout(set = 0, binding = 1, r32ui) restrict uniform uimage2DArray StateTable;

layout(set = 0, binding = 2, rgba32f) restrict uniform image2D ResidencyTable;

layout(set = 0, binding = 3, std430) readonly buffer VirtualTextureData {
    uint low_resolution_mip_count;
    uint high_resolution_mip_count;
    uint grid_size;
    uint total_fallback_tiles;

    uint lod_to_mip_map[32];
};

layout(set = 0, binding = 4, std430) buffer restrict TileRequestData {
    uint total_texture_slots;
    uint sqrt_total_texture_slots;
    uint request_buffer_size;
    uint _padding0;
};

layout(set = 0, binding = 5, std430) restrict buffer TileSlotCounter {
    uint tile_slot_counter;
};

layout(set = 0, binding = 6, std430) restrict buffer RequestBufferCounter {
    uint request_buffer_counter;
};

layout(set = 0, binding = 7, std430) buffer restrict TileIDs {
    uvec4 requested_tile_ids[];
};

#[include] res://Shaders/GLSL/ShaderIncludes/Constants.inc
#[include] res://Shaders/GLSL/ShaderIncludes/VirtualTextureFunctions.inc

void main() {
    const uint REQUESTED_MASK = 0x80000000u;
    const uint PIXEL_COUNT_MASK = 0x7FFFFFFFu;
    
    ivec3 size = imageSize(StateTable);

    ivec3 invocation_id = ivec3(gl_GlobalInvocationID.xyz);
    
    if (invocation_id.x >= size.x || invocation_id.y >= size.y || invocation_id.z >= size.z)
        return;
    
    ivec3 indirection_index = invocation_id;

    int total_resolution_mip_count = int(low_resolution_mip_count + high_resolution_mip_count);
    int mip_index = indirection_index.z % total_resolution_mip_count;

    int mip_size = int(grid_size) >> mip_index;

    if ((invocation_id.x % mip_size) != 0 || (invocation_id.y % mip_size) != 0)
        return;

    uint state = imageLoad(StateTable, indirection_index).r;
    bool is_requesting = (state & REQUESTED_MASK) != 0u;
    uint pixel_count = state & PIXEL_COUNT_MASK;

   if (pixel_count <= 1000)
        return;

    uvec4 indirection_data = floatBitsToUint(imageLoad(IndirectionTable, indirection_index));

    if (indirection_data.w != 0)
        return;

    uint request_index = atomicAdd(request_buffer_counter, 1);

    if (request_index >= request_buffer_size)
        return;

    uint tile_index = atomicAdd(tile_slot_counter, 1);
    uint usable_slots = total_texture_slots - total_fallback_tiles;
    uint slot = total_fallback_tiles + (tile_index % usable_slots);

    ivec2 residency_index = ivec2(
        slot % sqrt_total_texture_slots,
        slot / sqrt_total_texture_slots
    );

    uvec3 request_coords = uvec3(
        indirection_index.x / mip_size,
        indirection_index.y / mip_size,
        indirection_index.z
    );

    // Only invalidate if we actually had a previous tile
    uvec4 prev_tile_data = floatBitsToUint(imageLoad(ResidencyTable, residency_index));
    if (prev_tile_data.w != 0u) {
        int prev_mip_index = int(prev_tile_data.z) % total_resolution_mip_count;
        int prev_lod_size = int(grid_size) >> prev_mip_index;
        set_indirection_entry(IndirectionTable, ivec3(prev_tile_data.xyz), prev_lod_size, uvec4(0u));
    }

    requested_tile_ids[request_index] = uvec4(request_coords, slot);
    set_indirection_entry(IndirectionTable, indirection_index, mip_size, uvec4(slot, 0u, 0u, 255u));
    imageStore(ResidencyTable, residency_index, uintBitsToFloat(uvec4(indirection_index, 255u)));
}
