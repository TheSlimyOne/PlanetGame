; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Planet Game"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.2", "C#", "Forward Plus")

[autoload]

DebugManager="*res://Autoloads/DebugManager.tscn"
DebugManagerScript="*res://Autoloads/DebugManager.cs"

[dotnet]

project/assembly_name="Planet Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/asset-drawer/addons/Asset_Drawer/plugin.cfg", "res://addons/private-exports/plugin.cfg")

