code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying float vertexHeight;

uniform float height_scale = 0;
uniform float planet_radius = 20;
uniform float sea_level;
uniform sampler2D height_map;
uniform vec3 offset;
uniform sampler2D albedo_map;



void vertex() {
// Input:25
	vec3 n_out25p0 = NORMAL;


// FloatParameter:26
	float n_out26p0 = height_scale;


// FloatParameter:41
	float n_out41p0 = planet_radius;


// FloatOp:40
	float n_out40p0 = n_out26p0 * n_out41p0;


// FloatParameter:42
	float n_out42p0 = sea_level;


// Input:2
	vec3 n_out2p0 = VERTEX;


	vec2 n_out19p0;
// Expression:19
	n_out19p0 = vec2(0.0, 0.0);
	{
		n_out2p0 = normalize(n_out2p0);
		float longitude = atan(n_out2p0.x, n_out2p0.z);
		float latitude = asin(-n_out2p0.y);
		float u = (longitude / (2.0 * PI) + 0.5);
		float v = (latitude / PI) + 0.5;
		n_out19p0 = vec2(u, v);
	}


// IntConstant:22
	int n_out22p0 = 0;


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = textureLod(height_map, n_out19p0, float(n_out22p0));
	float n_out21p1 = n_out21p0.r;


	vec3 n_out43p0;
// If:43
	float n_in43p2 = 0.00001;
	vec3 n_in43p4 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out42p0 - n_out21p1) < n_in43p2)
	{
		n_out43p0 = vec3(n_out21p1);
	}
	else if(n_out42p0 < n_out21p1)
	{
		n_out43p0 = vec3(n_out21p1);
	}
	else
	{
		n_out43p0 = n_in43p4;
	}


// FloatOp:29
	float n_out29p0 = n_out40p0 * n_out43p0.x;


// Input:37
	vec3 n_out37p0 = VERTEX;


// MultiplyAdd:32
	vec3 n_out32p0 = fma(n_out25p0, vec3(n_out29p0), n_out37p0);


// Output:0
	VERTEX = n_out32p0;


// VaryingSetter:39
	vertexHeight = n_out29p0;


}

void fragment() {
// Input:3
	mat4 n_out3p0 = INV_VIEW_MATRIX;


// Input:2
	vec3 n_out2p0 = VERTEX;
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;
	float n_out2p3 = n_out2p0.b;


// VectorCompose:6
	float n_in6p3 = 0.00000;
	vec4 n_out6p0 = vec4(n_out2p1, n_out2p2, n_out2p3, n_in6p3);


// TransformVectorMult:7
	vec3 n_out7p0 = (n_out3p0 * vec4(vec3(n_out6p0.xyz), 1.0)).xyz;


// Vector3Parameter:8
	vec3 n_out8p0 = offset;


// VectorOp:9
	vec3 n_out9p0 = n_out7p0 + n_out8p0;


	vec2 n_out29p0;
// Expression:29
	n_out29p0 = vec2(0.0, 0.0);
	{
		n_out9p0 = normalize(n_out9p0);
		float longitude = atan(n_out9p0.x, n_out9p0.z);
		float latitude = asin(-n_out9p0.y);
		float u = (longitude / (2.0 * PI) + 0.5);
		float v = (latitude / PI) + 0.5;
		n_out29p0 = vec2(u, v);
	}


// IntConstant:26
	int n_out26p0 = 0;


	vec4 n_out25p0;
// Texture2D:25
	n_out25p0 = textureLod(albedo_map, n_out29p0, float(n_out26p0));


// Output:0
	ALBEDO = vec3(n_out25p0.xyz);


}
